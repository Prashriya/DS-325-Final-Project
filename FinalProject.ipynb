   "source": [
    "columns_to_keep = [\"YEAR\", \"ST_CASE\", \"MONTH\", \"DAY\", \"HOUR\", \"DAY_WEEK\", \"STATE\", \"WEATHER\"]\n",
    "crash_data = crashes[columns_to_keep].copy()\n",
    "\n",
    "print(\"Rows and columns\", crash_data.shape)\n",
    "crash_data.head()"
   ]
