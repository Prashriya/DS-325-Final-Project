   "source": [
    "study_data[\"TIME_OF_DAY\"] = pd.cut(\n",
    "    study_data[\"HOUR\"],\n",
    "    bins=[0, 6, 12, 18, 24],\n",
    "    labels=[\"Overnight\", \"Morning\", \"Afternoon\", \"Evening\"],\n",
    "    right=False\n",
    ")\n",
    "\n",
    "study_data[\"TIME_OF_DAY\"] = study_data[\"TIME_OF_DAY\"].cat.add_categories([\"Unknown\"])\n",
    "study_data[\"TIME_OF_DAY\"] = study_data[\"TIME_OF_DAY\"].fillna(\"Unknown\")\n",
    "\n",
    "time_by_group = pd.crosstab(\n",
    "    study_data[\"TIME_OF_DAY\"],\n",
    "    study_data[\"HOLIDAY_DAY\"],\n",
    "    normalize=\"columns\"\n",
    ") * 100\n",
    "\n",
    "time_by_group = time_by_group.rename(columns={0: \"Comparison %\", 1: \"Holiday %\"})\n",
    "time_by_group.round(2)"
   ]
