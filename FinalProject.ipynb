   "source": [
    "rates_by_year = study_data.groupby([\"YEAR\", \"HOLIDAY_DAY\"])[outcome_columns].mean()\n",
    "percent_by_year = rates_by_year.mean(axis=1) * 100\n",
    "\n",
    "yearly_table = percent_by_year.unstack()\n",
    "yearly_table = yearly_table.rename(columns={0: \"Comparison %\", 1: \"Holiday %\"})\n",
    "\n",
    "yearly_table[\"Gap (percentage points)\"] = (\n",
    "    yearly_table[\"Holiday %\"] - yearly_table[\"Comparison %\"]\n",
    ")\n",
    "\n",
    "yearly_table.round(2)"
   ]
